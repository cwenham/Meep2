<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Git, through LibGit2Sharp: committing edits to a running pipeline's file to a branch without touching the
    checkout (Q32). HTTPS remotes only, when remotes come (Q66).
  -->
  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" />
  </ItemGroup>
  <ItemGroup>
    <!-- For the helpers Meep's assemblies share: running programs, and finding your home folder and SSH key. -->
    <ProjectReference Include="..\Meep2.Shared\Meep2.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Meep2.Tests" />
  </ItemGroup>
</Project>
