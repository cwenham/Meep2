<Project Sdk="Microsoft.NET.Sdk">
  <!-- The core modules that ship with Meep (Interval, Fetch, Where, WriteLine, Save, Tap, Enumerate …). -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Shipped beside the assembly, so meep lsp's verb catalogue can describe each verb and parameter. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Kestrel, for Listen's HTTP inflection (Q96). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Enumerate's built-in books, one item to a line. -->
    <EmbeddedResource Include="Library\*.txt" LogicalName="Meep2.Modules.Library.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Meep2.SDK\Meep2.SDK.csproj" />
    <ProjectReference Include="..\Meep2.Shared\Meep2.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Meep2.Tests" />
    <InternalsVisibleTo Include="Meep2.Benchmarks" />
  </ItemGroup>
</Project>
