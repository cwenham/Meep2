<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Plugins: installing them from GitHub releases, NuGet or this machine, checking their SHAs and SSH signatures, and
    loading them into load contexts that can unload. Not AOT-compatible: a NativeAOT program can't load assemblies.
  -->
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Meep2.SDK\Meep2.SDK.csproj" />
    <ProjectReference Include="..\Meep2.Meeplang\Meep2.Meeplang.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Meep2.Tests" />
    <InternalsVisibleTo Include="Meep2.Benchmarks" />
  </ItemGroup>
</Project>
