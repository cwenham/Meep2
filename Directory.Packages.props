<Project>
  <!-- Package versions are set here once, not in each project. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <!-- For Ed25519, the key type most SSH keys use, which .NET doesn't have (Q101). -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
    <!-- Exports Meep's spans and metrics over OTLP, from the meep command (Q43). -->
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <!-- NuGet.Protocol asks for 8.0.1, which has known vulnerabilities; this matches the .NET 11 runtime. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Include="TUnit" Version="1.81.10" />
  </ItemGroup>
</Project>
